# Copy to .env and fill in. The app loads this automatically (python-dotenv).

# OpenAI — used for BOTH metadata extraction (GPT) and embeddings. Required.
OPENAI_API_KEY=sk-...

# Extraction model (any OpenAI model that supports Structured Outputs).
# LNP_OPENAI_MODEL=gpt-4o

# Embedding provider: "openai" (default) or "local" (sentence-transformers, no key).
# LNP_EMBEDDING_PROVIDER=openai

# Optional embedding overrides (apply to the active provider):
# LNP_EMBEDDING_MODEL=text-embedding-3-small   # openai default; or all-MiniLM-L6-v2 for local
# LNP_EMBEDDING_DIM=1536                         # must match the model (local MiniLM = 384)
